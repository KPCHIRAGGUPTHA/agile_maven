pipeline {
    agent any

    environment {
        MANIFEST_FILE = 'set-02-deploy-sample-app/sample-app.yaml'
        DEPLOYMENT_NAME = 'sample-app-deployment'
        SERVICE_NAME = 'sample-app-service'
    }

    options {
        timeout(time: 10, unit: 'MINUTES')
        timestamps()
    }

    stages {
        stage('Validate Manifest') {
            steps {
                echo '=== Stage 1: Validating Kubernetes Manifest ==='
                script {
                    if (isUnix()) {
                        sh "kubectl apply --dry-run=client -f ${MANIFEST_FILE}"
                    } else {
                        bat "kubectl apply --dry-run=client -f %MANIFEST_FILE%"
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo '=== Stage 2: Applying Deployment and Service to Cluster ==='
                script {
                    if (isUnix()) {
                        sh "kubectl apply -f ${MANIFEST_FILE}"
                    } else {
                        bat "kubectl apply -f %MANIFEST_FILE%"
                    }
                }
            }
        }

        stage('Wait for Rollout') {
            steps {
                echo '=== Stage 3: Waiting for deployment rollout to finish ==='
                script {
                    if (isUnix()) {
                        sh "kubectl rollout status deployment/${DEPLOYMENT_NAME} --timeout=120s"
                    } else {
                        bat "kubectl rollout status deployment/%DEPLOYMENT_NAME% --timeout=120s"
                    }
                }
            }
        }

        stage('Verify Deployment and Service') {
            steps {
                echo '=== Stage 4: Verifying deployed pods and service endpoints ==='
                script {
                    if (isUnix()) {
                        sh "kubectl get deployment ${DEPLOYMENT_NAME}"
                        sh "kubectl get pods -l app=sample-app -o wide"
                        sh "kubectl get svc ${SERVICE_NAME}"
                    } else {
                        bat "kubectl get deployment %DEPLOYMENT_NAME%"
                        bat "kubectl get pods -l app=sample-app -o wide"
                        bat "kubectl get svc %SERVICE_NAME%"
                    }
                }
            }
        }
    }

    post {
        success {
            echo "SUCCESS: Sample application successfully deployed to Kubernetes!"
        }
        failure {
            echo "FAILED: Deployment failed. Check kubectl logs and events."
        }
    }
}
