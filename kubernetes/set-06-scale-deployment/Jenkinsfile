pipeline {
    agent any

    parameters {
        string(name: 'TARGET_REPLICAS', defaultValue: '3', description: 'Target number of replicas to scale to')
    }

    environment {
        DEPLOY_MANIFEST = 'set-06-scale-deployment/deployment.yaml'
        DEPLOY_NAME = 'scalable-deployment'
    }

    options {
        timeout(time: 10, unit: 'MINUTES')
        timestamps()
    }

    stages {
        stage('Deploy Base Application') {
            steps {
                echo '=== Stage 1: Deploying base application with initial replica count ==='
                script {
                    if (isUnix()) {
                        sh "kubectl apply -f ${DEPLOY_MANIFEST}"
                        sh "kubectl rollout status deployment/${DEPLOY_NAME} --timeout=90s"
                    } else {
                        bat "kubectl apply -f %DEPLOY_MANIFEST%"
                        bat "kubectl rollout status deployment/%DEPLOY_NAME% --timeout=90s"
                    }
                }
            }
        }

        stage('Inspect Initial Replicas') {
            steps {
                echo '=== Stage 2: Checking initial replica state ==='
                script {
                    if (isUnix()) {
                        sh "kubectl get deployment ${DEPLOY_NAME}"
                        sh "kubectl get pods -l app=scalable-app"
                    } else {
                        bat "kubectl get deployment %DEPLOY_NAME%"
                        bat "kubectl get pods -l app=scalable-app"
                    }
                }
            }
        }

        stage('Scale Deployment to Target Replicas') {
            steps {
                echo "=== Stage 3: Scaling deployment '${DEPLOY_NAME}' to ${params.TARGET_REPLICAS} replicas ==="
                script {
                    if (isUnix()) {
                        sh "kubectl scale deployment/${DEPLOY_NAME} --replicas=${params.TARGET_REPLICAS}"
                    } else {
                        bat "kubectl scale deployment/%DEPLOY_NAME% --replicas=%TARGET_REPLICAS%"
                    }
                }
            }
        }

        stage('Wait for Scale Completion') {
            steps {
                echo '=== Stage 4: Waiting for all scaled replicas to become Ready ==='
                script {
                    if (isUnix()) {
                        sh "kubectl rollout status deployment/${DEPLOY_NAME} --timeout=120s"
                    } else {
                        bat "kubectl rollout status deployment/%DEPLOY_NAME% --timeout=120s"
                    }
                }
            }
        }

        stage('Verify Scaled Replicas') {
            steps {
                echo '=== Stage 5: Verifying all replicas are running ==='
                script {
                    if (isUnix()) {
                        sh "kubectl get deployment ${DEPLOY_NAME} -o wide"
                        sh "kubectl get pods -l app=scalable-app -o wide"
                    } else {
                        bat "kubectl get deployment %DEPLOY_NAME% -o wide"
                        bat "kubectl get pods -l app=scalable-app -o wide"
                    }
                }
            }
        }
    }

    post {
        success {
            echo "SUCCESS: Deployment '${DEPLOY_NAME}' successfully scaled to ${params.TARGET_REPLICAS} replicas!"
        }
        failure {
            echo "FAILED: Scaling operation failed."
        }
    }
}
