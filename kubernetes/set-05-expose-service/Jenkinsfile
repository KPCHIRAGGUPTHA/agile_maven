pipeline {
    agent any

    environment {
        DEPLOY_MANIFEST = 'set-05-expose-service/deployment.yaml'
        SERVICE_MANIFEST = 'set-05-expose-service/service.yaml'
        DEPLOY_NAME = 'service-demo-deployment'
        SERVICE_NAME = 'service-demo-service'
        NODE_PORT = '30085'
    }

    options {
        timeout(time: 10, unit: 'MINUTES')
        timestamps()
    }

    stages {
        stage('Validate Manifests') {
            steps {
                echo '=== Stage 1: Validating Deployment and Service YAMLs ==='
                script {
                    if (isUnix()) {
                        sh "kubectl apply --dry-run=client -f ${DEPLOY_MANIFEST} -f ${SERVICE_MANIFEST}"
                    } else {
                        bat "kubectl apply --dry-run=client -f %DEPLOY_MANIFEST% -f %SERVICE_MANIFEST%"
                    }
                }
            }
        }

        stage('Deploy Application & Service') {
            steps {
                echo '=== Stage 2: Deploying to Kubernetes Cluster ==='
                script {
                    if (isUnix()) {
                        sh "kubectl apply -f ${DEPLOY_MANIFEST}"
                        sh "kubectl apply -f ${SERVICE_MANIFEST}"
                    } else {
                        bat "kubectl apply -f %DEPLOY_MANIFEST%"
                        bat "kubectl apply -f %SERVICE_MANIFEST%"
                    }
                }
            }
        }

        stage('Wait for Pods Rollout') {
            steps {
                echo '=== Stage 3: Awaiting Pod Readiness ==='
                script {
                    if (isUnix()) {
                        sh "kubectl rollout status deployment/${DEPLOY_NAME} --timeout=120s"
                    } else {
                        bat "kubectl rollout status deployment/%DEPLOY_NAME% --timeout=120s"
                    }
                }
            }
        }

        stage('Verify Service & Endpoints') {
            steps {
                echo '=== Stage 4: Inspecting Service Details and Endpoint Mapping ==='
                script {
                    if (isUnix()) {
                        sh "kubectl get svc ${SERVICE_NAME} -o wide"
                        sh "kubectl describe svc ${SERVICE_NAME}"
                        sh "kubectl get endpoints ${SERVICE_NAME}"
                    } else {
                        bat "kubectl get svc %SERVICE_NAME% -o wide"
                        bat "kubectl describe svc %SERVICE_NAME%"
                        bat "kubectl get endpoints %SERVICE_NAME%"
                    }
                }
            }
        }

        stage('Test Service Connectivity') {
            steps {
                echo '=== Stage 5: Testing HTTP reachability through NodePort ==='
                script {
                    if (isUnix()) {
                        sh "curl -sI http://localhost:${NODE_PORT} || echo 'Curl tested.'"
                    } else {
                        bat "powershell -Command \"try { (Invoke-WebRequest -Uri 'http://localhost:${NODE_PORT}' -UseBasicParsing).StatusCode } catch { `$_.Exception.Message }\""
                    }
                }
            }
        }
    }

    post {
        success {
            echo "SUCCESS: Service '${SERVICE_NAME}' exposed application on port ${NODE_PORT} successfully!"
        }
        failure {
            echo "FAILED: Service exposure pipeline failed."
        }
    }
}
