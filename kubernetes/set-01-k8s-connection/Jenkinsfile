pipeline {
    agent any

    options {
        timeout(time: 10, unit: 'MINUTES')
        timestamps()
    }

    stages {
        stage('Check Kubernetes CLI') {
            steps {
                echo '=== Stage 1: Verifying kubectl installation ==='
                script {
                    if (isUnix()) {
                        sh 'kubectl version --client=true'
                    } else {
                        bat 'kubectl version --client=true'
                    }
                }
            }
        }

        stage('Verify Cluster Connection') {
            steps {
                echo '=== Stage 2: Checking Kubernetes API Server connectivity ==='
                script {
                    if (isUnix()) {
                        sh 'kubectl cluster-info'
                    } else {
                        bat 'kubectl cluster-info'
                    }
                }
            }
        }

        stage('Verify Cluster Nodes') {
            steps {
                echo '=== Stage 3: Inspecting cluster nodes status ==='
                script {
                    if (isUnix()) {
                        sh 'kubectl get nodes -o wide'
                    } else {
                        bat 'kubectl get nodes -o wide'
                    }
                }
            }
        }

        stage('Verify Namespaces and Permissions') {
            steps {
                echo '=== Stage 4: Checking namespaces and RBAC authorization ==='
                script {
                    if (isUnix()) {
                        sh 'kubectl get namespaces'
                        sh 'kubectl auth can-i create deployments --namespace=default'
                        sh 'kubectl auth can-i create pods --namespace=default'
                        sh 'kubectl auth can-i create services --namespace=default'
                    } else {
                        bat 'kubectl get namespaces'
                        bat 'kubectl auth can-i create deployments --namespace=default'
                        bat 'kubectl auth can-i create pods --namespace=default'
                        bat 'kubectl auth can-i create services --namespace=default'
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Jenkins successfully connected and verified communication with Kubernetes cluster!'
        }
        failure {
            echo 'FAILED: Unable to communicate with Kubernetes cluster. Please verify kubeconfig or cluster status.'
        }
    }
}
